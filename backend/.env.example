APP_NAME="CloudOps LLM Backend"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
API_PREFIX="/api"
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
LOG_LEVEL="INFO"
AWS_REGION="eu-north-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SESSION_TOKEN=""

# RAG Configuration
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
CHROMA_PERSIST_DIRECTORY="storage/chroma"
CHROMA_COLLECTION_NAME="cloudops_knowledge"
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
RAG_MIN_SCORE=0.0
